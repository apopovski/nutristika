# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

# Required: Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Required: Your Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Comma-separated list of admin emails
# Users with these emails will have admin access
# Alternative: Set admin role in Supabase user app_metadata
ADMIN_ALLOWED_EMAILS=admin@nutristika.com,jasmina@example.com
